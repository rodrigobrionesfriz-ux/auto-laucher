<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <cl.rodrigo.autolauncher.CockpitFrame
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra LED de velocidad (izquierda) -->
    <cl.rodrigo.autolauncher.LedBar
        android:id="@+id/speedBar"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="6dp"
        android:layout_marginTop="110dp"
        android:layout_marginBottom="110dp" />

    <!-- Vúmetro de la música (derecha) -->
    <cl.rodrigo.autolauncher.LedBar
        android:id="@+id/vuBar"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="110dp"
        android:layout_marginBottom="110dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Arriba: hora al centro y Apps a la derecha -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="62dp">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:textColor="@color/text"
                android:textSize="46sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnApps"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Apps"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apps"
                android:tint="@color/text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Izquierda: clima y accesos redondos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.29"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="18dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:id="@+id/weatherBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_plain"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/wx_cloud"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°"
                        android:textColor="@color/text"
                        android:textSize="36sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/weatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Esperando ubicación"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/weatherRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/text_dim"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/weatherPlace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <GridLayout
                    android:id="@+id/dock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:columnCount="3" />
            </LinearLayout>

            <!-- Centro: velocímetro con la camioneta -->
            <cl.rodrigo.autolauncher.CockpitGauge
                android:id="@+id/gauge"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.42" />

            <!-- Derecha: reproductor -->
            <LinearLayout
                android:id="@+id/musicText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.29"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="30dp">

                <cl.rodrigo.autolauncher.CircleFrame
                    android:id="@+id/musicInfo"
                    android:layout_width="214dp"
                    android:layout_height="214dp"
                    android:background="@drawable/bg_art_round"
                    android:foreground="@drawable/bg_round">

                    <ImageView
                        android:id="@+id/musicArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="40dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_music"
                        android:tint="@color/text_dim" />
                </cl.rodrigo.autolauncher.CircleFrame>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/musicElapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/musicTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/musicProgress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:max="1000"
                    android:progressBackgroundTint="@color/card_stroke"
                    android:progressTint="@color/accent" />

                <TextView
                    android:id="@+id/musicSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:drawableStart="@drawable/ic_music"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/accent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Música"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/musicTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="Sin reproducción"
                    android:textColor="@color/text"
                    android:layout_marginTop="2dp"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/musicArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Abajo: logo izquierdo, controles, logo derecho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/logoLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.29"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_plain">

                <ImageView
                    android:id="@+id/logoLeftImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/logoLeftText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.2"
                    android:maxLines="1"
                    android:textColor="#9AA6B4"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.42"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPhone"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="Teléfono"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phone"
                    android:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="Anterior"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev"
                    android:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle"
                    android:contentDescription="Reproducir"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="Siguiente"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    android:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btnMusic"
                    android:layout_width="62dp"
                    android:layout_marginStart="8dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="Música"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_music"
                    android:tint="@color/text" />
            </LinearLayout>

        <LinearLayout
            android:id="@+id/odoBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.29"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bg_odo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:text="ODO"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/odoTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="--"
                        android:textColor="@color/text"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:text="VIAJE"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/odoTrip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="0,0 km"
                        android:textColor="@color/accent"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTripReset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round"
                android:contentDescription="Reiniciar viaje"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_reset"
                android:tint="@color/text" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
