<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- Izquierda: hora, clima y carátula -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="60sp" />

            <TextClock
                android:id="@+id/date"
                style="@style/Dim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE d 'de' MMMM"
                android:format24Hour="EEEE d 'de' MMMM"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/weatherBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_plain"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/weatherIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/wx_cloud"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="@color/text"
                    android:textSize="34sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Esperando ubicación"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/weatherRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/weatherPlace"
                        style="@style/Dim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <cl.rodrigo.autolauncher.SquareFrame
                android:id="@+id/musicInfo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_art"
                android:foreground="@drawable/bg_plain">

                <ImageView
                    android:id="@+id/musicArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="40dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music"
                    android:tint="@color/text_dim" />
            </cl.rodrigo.autolauncher.SquareFrame>
        </LinearLayout>

        <!-- Centro: velocímetro -->
        <cl.rodrigo.autolauncher.SpeedGauge
            android:id="@+id/gauge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.45" />

        <!-- Derecha: accesos y Apps en la esquina -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnApps"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="Apps"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_apps"
                    android:tint="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

    <!-- Abajo: música -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:background="@drawable/bg_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/musicText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/musicSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_music"
                android:drawablePadding="4dp"
                android:drawableTint="@color/accent"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Música"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/musicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="Sin reproducción"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicArtist"
                style="@style/Dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/musicElapsed"
            style="@style/Dim"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/musicProgress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="0.7"
            android:max="1000"
            android:progressBackgroundTint="@color/card_stroke"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/musicTotal"
            style="@style/Dim"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Anterior"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="Reproducir"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_round"
            android:contentDescription="Siguiente"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next"
            android:tint="@color/text" />
    </LinearLayout>
</LinearLayout>
